#!/usr/bin/env bash
# check - test and build the Rust version (rust/) and the Go version (cmd/), check the Lean proofs, then hold the
# planner of EACH binary to the AMPL optimum.
# usage: ./check [instances]   (default 200)
set -eu
cd "$(dirname "$0")"
tmp="${TMPDIR:-/var/tmp}"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$tmp/smart-optimizer-target}"
py="${AMPL_PY:-$HOME/.local/share/ampl/bin/python}"

echo "== rust"
(cd rust && cargo clippy --offline --all-targets -- -D warnings && cargo test --offline && cargo build --offline --release)
rust_bin="$CARGO_TARGET_DIR/release/smart-optimizer"
echo "build ok (rust)"

echo "== go"
go vet ./...
go test ./...
go_bin="$tmp/smart-optimizer-check"
go build -o "$go_bin" ./cmd/smart-optimizer
echo "build ok (go)"

echo "== lean"
"${LEAN:-$HOME/.elan/bin/lean}" lean4/Plan.lean && echo "lean ok"

echo "== ampl: rust planner"
"$py" ampl/gap.py "${1:-200}" "$rust_bin" | tail -1
echo "== ampl: go planner"
"$py" ampl/gap.py "${1:-200}" "$go_bin" | tail -1
